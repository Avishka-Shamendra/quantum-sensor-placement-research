{
  "schema_version": 1,
  "dataset": "benchmark",
  "phase_data": {
    "interval": "(-pi, pi]",
    "definition": "r_ijm = Arg(exp(i*c*(f_i(x_m)-f_j(x_m))))",
    "reverse_pair": "r_jim = principal_phase(-r_ijm)",
    "stored_pairs": "i < j only",
    "sensor_threshold": "N_ijm = ceil(pi / abs(r_ijm)); undefined when r_ijm = 0",
    "phase_scale_c": 1.0
  },
  "sampling": "deterministic; model, K, and M marginal counts differ by at most one",
  "seed": 20260728,
  "models": {
    "fourier": {
      "formula": "f_i(x) = a0_i + a1_i sin(2 pi x) + b1_i cos(2 pi x) + a2_i sin(4 pi x) + b2_i cos(4 pi x)"
    },
    "gaussian": {
      "formula": "f_i(x) = A_i exp(-(x-mu_i)^2 / (2 sigma_i^2))"
    },
    "polynomial": {
      "formula": "f_i(x) = a0_i + a1_i u + a2_i u^2 + a3_i u^3, u = x - 1/2"
    },
    "sine": {
      "formula": "f_i(x) = A_i sin(2 pi q_i x + phi_i)"
    }
  },
  "requested_ranges": {
